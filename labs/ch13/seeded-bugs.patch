+@router.patch("/{event_id}/capacity", response_model=schemas.EventOut)
+def update_capacity(event_id: int, body: schemas.CapacityIn, db: Session = Depends(get_db)):
+    """Change the number of seats, e.g. when the event moves to a bigger hall."""
+    event = db.get(models.Event, event_id)
+    if event is None:
+        return {"error": "Event not found"}
+    event.capacity = body.capacity
+    db.commit()
+    db.refresh(event)
+    return _to_out(event)
