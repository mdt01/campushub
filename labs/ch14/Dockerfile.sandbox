# A sandbox image for running CampusHub's commands without network access:
#   docker build -t campushub-sandbox -f labs/ch14/Dockerfile.sandbox .
#   python -m minicode --workspace . --sandbox docker --sandbox-image campushub-sandbox
FROM python:3.12-slim
RUN useradd --create-home agent
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt ruff mypy bandit
USER agent
WORKDIR /work
